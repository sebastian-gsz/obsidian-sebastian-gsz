# Common .gitignore for a WordPress Docker project / Archivo común de .gitignore para un proyecto de WordPress con Docker
# OS generated files / Archivos generados por el sistema operativo
.DS_Store
Thumbs.db

# Logs / Registros
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories / Directorios de dependencias
vendor/
node_modules/

# Environment files
.env
.env.*

# Docker configuration / Configuración de Docker
docker-compose.override.yml

# Build/artifact directories (if any) / Directorios de construcción/artifactos (si los hay)
dist/
build/
public/

# IDE / editor settings / Configuración de IDE/editor
*.iml
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# Miscellaneous / Misceláneos
*.cache

# Ignore directorios específicos / Ignore specific directories
gitbook/
.trash/
trash/  
